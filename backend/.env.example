# Backend Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# MongoDB Connection String (REQUIRED for production)
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# For local MongoDB: mongodb://localhost:27017/CourseFlow
MONGODB_URI=mongodb://localhost:27017/CourseFlow

# Optional: Only set these if you want to override defaults from application.yml
# JWT_SECRET - Default: placeholder (MUST be changed in production)
# SERVER_PORT - Default: 4000
# SPRING_PROFILES_ACTIVE - Default: dev
# CORS_ALLOWED_ORIGINS - Default: http://localhost:5173,http://localhost:3000
# JWT_ACCESS_TOKEN_TTL - Default: 900000 (15 minutes)
# JWT_REFRESH_TOKEN_TTL - Default: 604800000 (7 days)
