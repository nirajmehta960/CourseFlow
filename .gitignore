# CourseFlow Monorepo - Root Level .gitignore
# This repository contains both frontend and backend code

# Shared: IDE/Editor folders
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.vite/
.npm/
.cache/

# Shared: Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Shared: OS files
.DS_Store
Thumbs.db

# Frontend build artifacts (if built at root - should be in frontend/dist)
dist/
build/
.next/
out/

# Dependencies (should be in frontend/node_modules and backend/target)
node_modules/
.pnp
.pnp.js

# Environment files (frontend/.env and backend/.env)
.env
.env.local
.env.*.local
*.env
!.env.example

# Testing
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp

# Deployment documentation (keep README.md, DEPLOYMENT.md, CICD.md, and AWS_S3_SETUP.md)
*.md
!README.md
!DEPLOYMENT.md
!CICD.md
!AWS_S3_SETUP.md

# Secrets
*.pem
